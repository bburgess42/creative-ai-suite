# Copy to .env and fill in real values. .env is gitignored — never commit keys.

# --- Text + image generation (Google Gemini / Imagen) ---
GEMINI_API_KEY=your-gemini-api-key

# --- Text-to-speech (ElevenLabs) ---
ELEVENLABS_API_KEY=your-elevenlabs-api-key
ELEVENLABS_VOICE_ID=your-voice-id

# --- Video animation backends ---
# NOTE: the animation router in this extract only does cost-aware *selection* and
# reads no keys. These are the keys the production render backends would use; they
# are listed for completeness and are not consumed by any code in this repo.
LUMA_API_KEY=your-luma-api-key
EVOLINK_API_KEY=your-evolink-api-key

# --- Cost ledger location (optional) ---
# Where the cost-logger writes the shared JSON ledger.
# Defaults to ./data/api-costs.json relative to the process working dir.
COST_LEDGER_PATH=./data/api-costs.json
